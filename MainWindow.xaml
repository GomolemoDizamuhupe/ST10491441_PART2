<Window x:Class="PART2_POE_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PART2_POE_"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid
        Background="Black"
        >


        <Grid
            x:Name="welcome_grid"
            Visibility="Visible"
            >
            
            <Image
                Source="/logo.png"
                Width="200"
                Height="100"
                Margin="0, -200, 0, 0"
                />

            <TextBlock
                Text="Hello! Welcome to the Cybersecurity Awareness Bot. I'm here to help you to stay safe online."
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="12"
                FontFamily="Cascadia Code"
                Foreground="LimeGreen"
                />

            <Button
                Content="Start ChatBot"
                FontFamily="Cascadia Code"
                Width="100"
                Height="50"
                Margin="0, 200, 0, 0"
                Click="start_bot"
                Foreground="LimeGreen"
                Background="Black"
                />
        </Grid>


        <Grid
            x:Name="username_grid"
            Visibility="Hidden"
            >

            <Image
                Source="/logo.png"
                Width="200"
                Height="100"
                Margin="0, -200, 0, 0"
                />

            <TextBlock
                Text="Enter your name: "
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="12"
                FontFamily="Cascadia Code"
                Foreground="LimeGreen"
                Background="Black"
                />

            <TextBox
                x:Name="txtUsername"
                Width="200"
                Height="50"
                Margin="0, 150, 100, 0"
                BorderBrush="LimeGreen"
                Foreground="LimeGreen"
                Background="Black"
                />

            <Button
                Click="submit_username"
                FontFamily="Cascadia Code"
                Content="Submit"
                Width="100"
                Height="50"
                Margin="0, 150, -200, 0"
                BorderBrush="LimeGreen"
                Foreground="LimeGreen"
                Background="Black"
                />
        </Grid>

        <Grid
            x:Name="chatbot_grid"
            Visibility="Hidden"
            Background="Black"
            >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>


            <Image
            Source="/logo.png"
            />

            <!-- Message List -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding Messages}" 
                      Margin="0,0,0,10"
                      Width="800"
                        BorderBrush="LimeGreen"
                        Foreground="LimeGreen"
                        Background="Black"
                      >
                <ListView.View>
                    <GridView>
                        <GridViewColumn 
                            Header="Sender"
                            Width="200"  
                            DisplayMemberBinding="{Binding Sender}"
                            />
                        <GridViewColumn 
                            Header="Message" 
                            Width="400"
                            >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                        Text="{Binding Text}"
                                        FontFamily="Cascadia Code"
                                        Foreground="{Binding MessageColor}"
                                        TextWrapping="Wrap"
                                        MaxWidth="390"
                                        />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn 
                            Header="Time" 
                            Width="200" 
                            DisplayMemberBinding="{Binding Time}"
                            />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Input Area -->
            <Grid Grid.Row="2">

                <TextBox 
                    x:Name="txtUserResponse"
                    FontFamily="Cascadia Code"
                    Width="300"
                    Height="50"
                    Margin="0, 0, 200, 0"
                    BorderBrush="LimeGreen"
                    Foreground="LimeGreen"
                    Background="Black"
                    />

                <Button 
                    Content="Send" 
                    FontFamily="Cascadia Code"
                    Width="150"
                    Height="50"
                    Margin="250, 0, 0, 0"
                    BorderBrush="LimeGreen"
                    Foreground="LimeGreen"
                    Background="Black"
                    Click="submit_response"
                    />

                <Button 
                    Content="Exit" 
                    FontFamily="Cascadia Code"
                    Width="150"
                    Height="50"
                    Margin="700, 0, 0, 0"
                    Click="Exit_chatbot"
                    BorderBrush="LimeGreen"
                    Foreground="LimeGreen"
                    Background="Black"
                    />

            </Grid>


        </Grid>
    </Grid>
</Window>
